# ==============================================================================
# Normalizzazione fine riga (Line Endings)
# ==============================================================================
* text=auto eol=lf

# File di testo espliciti
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf

# File binari generici
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
*.ink binary
*.xopp binary

# ==============================================================================
# Git Large File Storage (Git LFS)
# Necessario per file PDF e archivi superiori a 100 MB (limite massimo di GitHub)
# ==============================================================================
*.pdf filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.rar filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text

